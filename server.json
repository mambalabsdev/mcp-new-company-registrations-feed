{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.mambabuilt/mcp-new-company-registrations-feed",
  "description": "Newly registered companies from UK, Norway, Finland, and France registers, one row per company.",
  "version": "1.0.0",
  "repository": {
    "url": "https://github.com/mambalabsdev/mcp-new-company-registrations-feed",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@mambalabsdev/mcp-new-company-registrations-feed",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APIFY_TOKEN",
          "description": "Apify API token from https://console.apify.com/account/integrations",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        },
        {
          "name": "COMPANIES_HOUSE_API_KEY",
          "description": "Optional. Your own free UK Companies House REST API key. Without it the UK register is skipped.",
          "isRequired": false,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
